<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="4dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewPatientUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username: sahil123"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/textViewRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room: Room1"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/textViewBed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bed: bed1"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Admitted"
            android:textSize="14sp"
            android:textColor="#008000"
            android:layout_marginTop="2dp"/>

        <Button
            android:id="@+id/btnViewReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Report"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnDischarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discharge"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/error_red"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
