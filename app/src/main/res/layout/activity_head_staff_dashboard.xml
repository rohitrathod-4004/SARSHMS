<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_dashboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Head Staff Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_set_hospital_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Hospital Info"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_manual_admit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manually Admit a Patient"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_view_room_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Room &amp; Bed Status"
            android:layout_marginTop="20dp"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_manage_beds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Beds"
            android:layout_marginTop="20dp"
            android:backgroundTint="#795548"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_admission_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Admission Requests"
            android:layout_marginTop="20dp"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_view_admitted_patients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Admitted Patients"
            android:layout_marginTop="20dp"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF" />


    </LinearLayout>
</ScrollView>
