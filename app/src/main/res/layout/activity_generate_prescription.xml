<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Form Fields for Prescription -->
    <EditText
        android:id="@+id/editTextSymptoms"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Symptoms" />

    <EditText
        android:id="@+id/editTextDiagnosis"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Diagnosis" />

    <EditText
        android:id="@+id/editTextMedicines"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Medicines" />

    <EditText
        android:id="@+id/editTextNotes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Additional Notes" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmitPrescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Prescription" />
</LinearLayout>
