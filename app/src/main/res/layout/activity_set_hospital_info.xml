<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Step 1: Enter total rooms -->
    <EditText
        android:id="@+id/et_total_rooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter total number of rooms"
        android:inputType="number" />

    <Button
        android:id="@+id/btn_generate_rooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate Rooms" />

    <!-- Step 2: RecyclerView for room details -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_rooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp" />
</LinearLayout>
